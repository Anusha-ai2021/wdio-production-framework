# Which environment config block to use in wdio.conf.js: dev | staging | prod
TEST_ENV=dev

# Base URLs per environment
DEV_BASE_URL=https://www.saucedemo.com/
STAGING_BASE_URL=https://www.saucedemo.com/
PROD_BASE_URL=https://www.saucedemo.com/

# Sauce Demo test credentials
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Run headless (true in CI, false/omit for local debugging)
HEADLESS=false

# --- Jira defect auto-logging (leave blank to disable) ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=QA
JIRA_ISSUE_TYPE=Bug
JIRA_ENABLED=false
